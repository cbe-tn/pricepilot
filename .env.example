# Postgres connection string.
# Local: postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Supabase: Project → Connect → "Session pooler" URI (port 5432), without ?sslmode
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Secret expected by /api/cron (Authorization: Bearer <CRON_SECRET>). Long random string.
CRON_SECRET=change-me

# Optional: set to 0 to disable the in-process background scheduler on a normal server.
# PRICEPILOT_SCHEDULER=0
